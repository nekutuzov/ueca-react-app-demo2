{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "paths": {
      "@components": [
        "./src/components"
      ],
      "@core": [
        "./src/core"
      ],
      "@api": [
        "./src/api"
      ],
      "@screens": [
        "./src/screens"
      ],
      "@test": [
        "./src/test"
      ]
    }
  },
  "include": [
    "src/vite-env.d.ts",
    "src/test",
    "src/integration",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.testUtils.ts",
    "src/**/*.testUtils.tsx"
  ],
  "exclude": []
}
